# ==============================================================================
# HYBRID TOURISM MAP — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MAP TILE PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Default provider: 'esri' (Recommended for tourism - free, clean, no API key required)
# Options:
#   - 'esri': Esri World Street Map (Free, pastel travel palette, no key)
#   - 'osm': Standard OpenStreetMap (Free, high street detail, no key)
#   - 'maptiler': MapTiler Vector/Raster tiles (Requires VITE_MAPTILER_API_KEY)
#   - 'carto': CARTO Basemaps (Requires VITE_CARTO_API_KEY)
VITE_MAP_PROVIDER=esri

# If using MapTiler (https://cloud.maptiler.com):
VITE_MAPTILER_API_KEY=

# If using CARTO paid tiles (https://carto.com):
VITE_CARTO_API_KEY=

# If using Mapbox styles:
VITE_MAPBOX_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 2. AI ASSISTANT & GROUNDED ORCHESTRATION
# ------------------------------------------------------------------------------
# Provider options:
#   - 'mock': Built-in grounded query validator using verified dataset (Default for Phase 0)
#   - 'gemini': Google Gemini API (Structured tool-calling)
#   - 'openai': OpenAI GPT-4o / GPT-4o-mini
VITE_AI_PROVIDER=mock

# Google Gemini API Key (Get at https://aistudio.google.com/):
VITE_GEMINI_API_KEY=

# OpenAI API Key (Get at https://platform.openai.com/):
VITE_OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 3. BACKEND API & DESTINATION DEFAULTS
# ------------------------------------------------------------------------------
# Backend API URL (for Phase 1 CMS / PostGIS API container):
VITE_API_URL=http://localhost:3000/api

# Default destination & viewport (Sông Hàn, Đà Nẵng)
VITE_APP_TITLE=Đà Nẵng Hybrid Tourism Map
VITE_DEFAULT_DESTINATION_ID=dest_danang
VITE_DEFAULT_LNG=108.2255
VITE_DEFAULT_LAT=16.0610
VITE_DEFAULT_ZOOM=15.5
VITE_DEFAULT_PITCH=50
VITE_DEFAULT_BEARING=-15

# Default Quality Tier: 'high' | 'medium' | 'low'
VITE_DEFAULT_QUALITY_TIER=high
